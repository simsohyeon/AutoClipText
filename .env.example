# === 텔레그램 봇 ===
# @BotFather 에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=

# (선택) 이 ID 의 사용자만 봇을 쓸 수 있게 제한. 비워두면 누구나 사용 가능.
# 본인 텔레그램 숫자 ID. @userinfobot 에게 말 걸면 알려줌.
ALLOWED_TELEGRAM_USER_IDS=

# === Google Gemini API (무료) ===
# https://aistudio.google.com → Get API key 에서 발급 (카드 등록 불필요)
GEMINI_API_KEY=
# 글 생성에 쓸 모델. 무료 티어로 충분.
GEMINI_MODEL=gemini-2.5-flash

# === 동작 옵션 ===
# 여러 장 사진을 모을 때, 마지막 사진 도착 후 이 시간(ms) 동안 추가 사진이 없으면 한 묶음으로 처리
GROUP_DEBOUNCE_MS=3000
